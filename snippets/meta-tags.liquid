{%- comment -%}
  Open Graph / Twitter tags and site-level JSON-LD.
  Canonical uses Shopify's own canonical_url (one tag, no manual URL). Product JSON-LD is rendered by the
  native `structured_data` filter in sections/main-product.liquid. Breadcrumb JSON-LD is built here.
{%- endcomment -%}
<link rel="canonical" href="{{ canonical_url }}">
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_image = nil
  if template.name == 'product' and product.featured_image
    assign og_image = product.featured_image
  elsif template.name == 'collection' and collection.image
    assign og_image = collection.image
  elsif template.name == 'article' and article.image
    assign og_image = article.image
  elsif settings.logo
    assign og_image = settings.logo
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
{%- if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
{%- if og_image %}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ og_image.width | at_most: 1200 }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif %}
<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- if settings.logo %}, "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif %}
  {%- assign sameas = '' -%}
  {%- if settings.social_instagram != blank %}{% assign sameas = sameas | append: settings.social_instagram | append: '|' %}{% endif -%}
  {%- if settings.social_tiktok != blank %}{% assign sameas = sameas | append: settings.social_tiktok | append: '|' %}{% endif -%}
  {%- if settings.social_facebook != blank %}{% assign sameas = sameas | append: settings.social_facebook | append: '|' %}{% endif -%}
  {%- if sameas != blank %}, "sameAs": {{ sameas | split: '|' | json }}{% endif %}
}
</script>
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "WebSite", "name": {{ shop.name | json }}, "url": {{ shop.url | json }},
  "potentialAction": { "@type": "SearchAction", "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }}, "query-input": "required name=search_term_string" } }
</script>
{%- endif -%}

{%- if template.name == 'product' or template.name == 'collection' -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": {{ shop.url | json }} }
  {%- if template.name == 'product' %}
    {%- if collection.url %}, { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
    {%- else %}, { "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }{% endif %}
  {%- else %}, { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }} }{% endif %}
] }
</script>
{%- endif -%}
