  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8.500h14l-1.100 11a1 1 0 0 1-1 .9H7.100a1 1 0 0 1-1-.9z"/><path d="M9 8.500V7a3 3 0 0 1 6 0v1.500"/></svg>
  {%- when 'shopapp' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 12H6z"/><path d="M9 11V7a3 3 0 0 1 6 0v4"/></svg>
  {%- when 'wisp' -%}
