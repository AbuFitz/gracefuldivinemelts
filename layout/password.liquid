<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    {%- style -%}
      :root { --c-paper: {{ settings.color_paper }}; --c-ink: {{ settings.color_ink }}; --c-blush: {{ settings.color_blush }}; --c-pink: {{ settings.color_pink }}; --c-rose: {{ settings.color_rose }}; }
    {%- endstyle -%}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="main" tabindex="-1">{{ content_for_layout }}</main>
  </body>
</html>
