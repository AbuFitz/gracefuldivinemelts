<section class="section" aria-labelledby="rt-h-{{ section.id }}">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}<h2 id="rt-h-{{ section.id }}" style="margin-bottom:var(--s-5)">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="prose">{{ section.settings.text }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your words here.</p>" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
