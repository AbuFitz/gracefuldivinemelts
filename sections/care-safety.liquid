{%- assign head_title = page.title | escape -%}
{%- render 'page-head', title: head_title, lede: section.settings.lede -%}
<div class="wrap" style="padding-block:var(--s-7) var(--section-y)">
  <div class="care-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'card' -%}
        <div class="care-card" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><div class="prose">{{ block.settings.content }}</div></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- for block in section.blocks -%}
    {%- if block.type == 'warning' -%}
      <div class="care-warn on-dark" style="margin-top:var(--s-7)" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><div class="prose" style="max-width:none">{{ block.settings.content }}</div></div>
    {%- endif -%}
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Care and safety",
  "settings": [
    { "type": "textarea", "id": "lede", "label": "Intro" }
  ],
  "blocks": [
    { "type": "card", "name": "Guidance card", "settings": [
      { "type": "text", "id": "title", "label": "Title" }, { "type": "richtext", "id": "content", "label": "Content" } ] },
    { "type": "warning", "name": "Safety panel", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Safety first" }, { "type": "richtext", "id": "content", "label": "Content" } ] }
  ]
}
{% endschema %}
