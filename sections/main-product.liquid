{%- liquid
  assign current = product.selected_or_first_available_variant
  assign is_pairs = false
  if product.template_suffix == 'bundle'
    assign is_pairs = true
  endif
  assign is_custom = false
  if product.template_suffix == 'custom-scent'
    assign is_custom = true
  endif
  assign family = product.metafields.custom.scent_family.value
  assign images = product.media | where: 'media_type', 'image'
  assign square = false
  if product.featured_media.aspect_ratio and product.featured_media.aspect_ratio > 0.9
    assign square = true
  endif
  assign form_id = 'ProductForm-' | append: section.id
  assign shipping_url = shop.shipping_policy.url
  assign refund_url = shop.refund_policy.url
  assign faces = section.settings.faces_collection
-%}
<div class="wrap" data-product>
  <div class="pdp">
    <div class="gallery" data-gallery>
      <div class="gallery__track" data-gallery-track>
        {%- for m in images -%}
          <figure class="gallery__slide{% if forloop.first and square %} is-square{% endif %}" data-media-id="{{ m.id }}">
            {%- if forloop.first -%}
              {%- render 'image', image: m.preview_image, sizes: '(min-width: 960px) 52vw, 86vw', loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1280,1600' -%}
            {%- else -%}
              {%- render 'image', image: m.preview_image, sizes: '(min-width: 960px) 26vw, 86vw', widths: '480,720,960,1280' -%}
            {%- endif -%}
          </figure>
        {%- else -%}
          <figure class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</figure>
        {%- endfor -%}
      </div>
      {%- if images.size > 1 -%}<div class="gallery__dots js-only" aria-hidden="true" data-gallery-dots>{%- for m in images -%}<span class="{% if forloop.first %}is-on{% endif %}"></span>{%- endfor -%}</div>{%- endif -%}
    </div>

    <div class="pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'breadcrumbs' -%}
              {%- if family != blank -%}<p class="eyebrow">{{ family }}</p>{%- endif -%}
              <h1 class="pdp__title">{{ product.title | escape }}</h1>
            </div>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              <div class="pdp__row">
                <div class="pdp__price" data-price-wrap>{% render 'price', product: product, variant: current %}</div>
                <span class="stock{% unless current.available %} stock--out{% endunless %}" data-stock>{% if current.available %}{{ 'products.in_stock' | t }}{% else %}{{ 'products.out_of_stock' | t }}{% endif %}</span>
              </div>
              <p class="tax-note">
                {%- if cart.taxes_included -%}{{ 'products.tax_included' | t }} {% endif -%}
                {{ 'products.shipping_calculated' | t }}
                {%- if shipping_url != blank %} <a href="{{ shipping_url }}">{{ 'products.links.shipping' | t }}</a>{% endif -%}
              </p>
            </div>

          {%- when 'buy' -%}
            <div {{ block.shopify_attributes }}>
              {%- if is_custom -%}
                <div class="custom-box">
                  <h2>{{ block.settings.custom_heading }}</h2>
                  <label for="CustomScent-{{ section.id }}">{{ 'products.custom_scent.label' | t }}</label>
                  <input class="input" id="CustomScent-{{ section.id }}" form="{{ form_id }}" type="text" name="properties[{{ 'products.custom_scent.property' | t }}]" required maxlength="120" placeholder="{{ 'products.custom_scent.placeholder' | t }}" autocomplete="off" aria-describedby="CustomScentHint-{{ section.id }}" data-prefill-scent>
                  <span class="field-hint" id="CustomScentHint-{{ section.id }}" style="color:var(--c-ink)">{{ block.settings.custom_note }}</span>
                  {%- if block.settings.included != blank -%}
                    <ul class="included" role="list">{%- assign inc = block.settings.included | newline_to_br | split: '<br />' -%}{%- for line in inc -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- form 'product', product, id: form_id, class: 'buy-form', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current.id }}">
                {%- unless product.has_only_default_variant -%}
                  <div class="options" style="margin-bottom:var(--s-5)">
                    {%- for option in product.options_with_values -%}
                      {%- assign opt_idx = forloop.index0 -%}
                      <fieldset class="option{% if is_pairs %} option--pairs{% endif %}">
                        <legend>{{ option.name | escape }} <span data-selected-value>{{ option.selected_value | escape }}</span></legend>
                        <div class="option__values">
                          {%- for value in option.values -%}
                            {%- assign v_id = 'opt-' | append: section.id | append: '-' | append: opt_idx | append: '-' | append: forloop.index -%}
                            {%- assign match = nil -%}
                            {%- if product.options.size == 1 -%}{%- assign match = product.variants[forloop.index0] -%}{%- endif -%}
                            <div class="opt">
                              <input type="radio" id="{{ v_id }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-index="{{ opt_idx }}" {% if option.selected_value == value %}checked{% endif %}>
                              <span>
                                {%- if is_pairs and value contains ' & ' -%}
                                  {%- assign pair = value | split: ' & ' -%}
                                  <span class="opt__faces" aria-hidden="true">
                                    {%- for name in pair -%}
                                      {%- assign face = nil -%}
                                      {%- if faces != blank -%}{%- for fp in faces.products -%}{%- if fp.title == name -%}{%- assign face = fp -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
                                      {%- if face and face.featured_image -%}{%- render 'image', image: face.featured_image, sizes: '34px', widths: '68,102', alt: '' -%}{%- else -%}<i></i>{%- endif -%}
                                    {%- endfor -%}
                                  </span>
                                  <label for="{{ v_id }}" style="font-weight:inherit;cursor:pointer;flex:1">{{ pair[0] | escape }} <span class="opt__amp">&amp;</span> {{ pair[1] | escape }}</label>
                                {%- else -%}
                                  <label for="{{ v_id }}" style="font-weight:inherit;cursor:pointer;flex:1">{{ value | escape }}{%- if match and match.available == false %} <em class="muted" style="color:inherit">({{ 'products.sold_out' | t }})</em>{% endif -%}</label>
                                {%- endif -%}
                              </span>
                            </div>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

                <div class="buy">
                  <div class="qty" role="group" aria-label="{{ 'products.quantity.label' | t }}">
                    <button type="button" class="js-only" data-qty-step="-1" aria-label="{{ 'products.quantity.decrease' | t }}">&minus;</button>
                    <input type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" aria-label="{{ 'products.quantity.label' | t }}">
                    <button type="button" class="js-only" data-qty-step="1" aria-label="{{ 'products.quantity.increase' | t }}">+</button>
                  </div>
                  <button type="submit" class="btn" data-add-btn data-buy-anchor {% unless current.available %}aria-disabled="true"{% endunless %}>
                    {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                  </button>
                  <p class="notice notice--error buy__error" data-form-error role="alert" hidden></p>
                </div>
                {%- if section.settings.dynamic_checkout and block.settings.dynamic_checkout and is_custom == false -%}{{ form | payment_button }}{%- endif -%}
              {%- endform -%}

              <script type="application/json" data-variants>
                [{%- for v in product.variants -%}
                  {%- capture price_html -%}{%- render 'price', product: product, variant: v -%}{%- endcapture -%}
                  {
                    "id": {{ v.id }}, "available": {{ v.available | json }}, "options": {{ v.options | json }}, "price_html": {{ price_html | strip | json }}
                    {%- if v.featured_media %}, "media": {{ v.featured_media.id | json }}{% endif -%}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}]
              </script>
            </div>

          {%- when 'notes' -%}
            <div {{ block.shopify_attributes }}>{%- render 'scent-notes', product: product -%}</div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details open><summary>{{ block.settings.heading | default: 'About this scent' }}</summary><div class="accordion__body prose">{{ product.description }}</div></details>
              </div>
            {%- endif -%}

          {%- when 'accordion' -%}
            {%- if block.settings.content != blank -%}
              <div class="accordion" {{ block.shopify_attributes }}><details><summary>{{ block.settings.heading }}</summary><div class="accordion__body">{{ block.settings.content }}</div></details></div>
            {%- endif -%}

          {%- when 'care_link' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <details>
                <summary>{{ 'products.care.heading' | t }}</summary>
                <div class="accordion__body">
                  <ul style="padding-left:1.1em;display:grid;gap:.4rem">
                    <li>{{ 'products.care.never_unattended' | t }}</li><li>{{ 'products.care.keep_away' | t }}</li><li>{{ 'products.care.no_water' | t }}</li>
                  </ul>
                  {%- if settings.care_page != blank -%}<p><a href="{{ settings.care_page.url }}">{{ 'products.care.link' | t }}</a></p>{%- endif -%}
                </div>
              </details>
            </div>

          {%- when 'trust' -%}
            {%- if block.settings.items != blank -%}
              <ul class="trust" role="list" {{ block.shopify_attributes }}>
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'policy_links' -%}
            <p class="tax-note" {{ block.shopify_attributes }}>
              {%- if shipping_url != blank -%}<a href="{{ shipping_url }}">{{ 'products.links.shipping' | t }}</a>{%- endif -%}
              {%- if shipping_url != blank and refund_url != blank %} · {% endif -%}
              {%- if refund_url != blank -%}<a href="{{ refund_url }}">{{ 'products.links.returns' | t }}</a>{%- endif -%}
            </p>

          {%- when 'disclaimer' -%}
            {%- assign inspired = product.metafields.custom.inspired_by.value -%}
            {%- assign desc_has_it = false -%}
            {%- if product.description contains 'not affiliated' -%}{%- assign desc_has_it = true -%}{%- endif -%}
            {%- if desc_has_it == false and inspired != blank or desc_has_it == false and block.settings.always -%}
              <p class="disclaimer" {{ block.shopify_attributes }}>{%- if inspired != blank -%}<strong>{{ 'products.inspired_by' | t: name: inspired }}.</strong> {% endif -%}{{ settings.inspired_disclaimer }}</p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<div class="buybar js-only" data-buybar aria-hidden="true">
  <div class="buybar__t">{{ product.title | escape }}<span data-buybar-price>{% render 'price', product: product, variant: current %}</span></div>
  <button type="submit" class="btn" form="{{ form_id }}" tabindex="-1" {% unless current.available %}aria-disabled="true"{% endunless %} data-buybar-btn>{%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</button>
</div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "dynamic_checkout", "label": "Offer dynamic checkout buttons (Shop Pay, Apple Pay…) where enabled in Shopify", "default": true },
    { "type": "collection", "id": "faces_collection", "label": "Collection used for the small scent pictures in the bundle pair picker" }
  ],
  "blocks": [
    { "type": "title", "name": "Title and breadcrumbs", "limit": 1 },
    { "type": "price", "name": "Price and stock", "limit": 1 },
    { "type": "buy", "name": "Variants and bag button", "limit": 1, "settings": [
      { "type": "checkbox", "id": "dynamic_checkout", "label": "Show dynamic checkout button here", "default": true },
      { "type": "text", "id": "custom_heading", "label": "Custom scent: box heading", "default": "Tell us the scent you have in mind" },
      { "type": "textarea", "id": "custom_note", "label": "Custom scent: availability note", "default": "Requests are subject to availability." },
      { "type": "textarea", "id": "included", "label": "Custom scent: what is included (one per line)", "default": "3 wax melts in your requested scent" } ] },
    { "type": "notes", "name": "Scent notes", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1, "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "About this scent" }] },
    { "type": "care_link", "name": "Use and safety", "limit": 1 },
    { "type": "accordion", "name": "Custom accordion", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery" }, { "type": "richtext", "id": "content", "label": "Content" } ] },
    { "type": "trust", "name": "Reassurance list", "limit": 1, "settings": [
      { "type": "textarea", "id": "items", "label": "One point per line", "default": "Poured by hand in small batches\nSecure checkout through Shopify" } ] },
    { "type": "policy_links", "name": "Delivery and returns links", "limit": 1 },
    { "type": "disclaimer", "name": "Inspired-by disclaimer", "limit": 1, "settings": [
      { "type": "checkbox", "id": "always", "label": "Show even when the product has no 'inspired by' field", "default": true } ] }
  ]
}
{% endschema %}
