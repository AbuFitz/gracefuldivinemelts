{%- comment -%}
  Instagram marquee: a continuous, seamless CSS loop (no hover pause, no dragging). Two identical groups; the second is aria-hidden + inert
  so keyboard and screen-reader users meet each item once. Reduced motion: static, scrollable single set.
  Items link to the real Instagram profile (or a specific post/reel URL if you paste one). No third-party app or script.
{%- endcomment -%}
{%- assign profile = settings.social_instagram -%}
<section class="section" aria-labelledby="media-h-{{ section.id }}" style="padding-top:0">
  <div class="wrap">
    <div class="head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="media-h-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if profile != blank -%}<a class="btn" href="{{ profile }}" rel="noopener" target="_blank">{% render 'brand-icon', name: 'instagram' %}<span style="margin-left:.1rem">{{ section.settings.follow_text }} @{{ settings.instagram_handle }}</span></a>{%- endif -%}
    </div>
  </div>
  <div class="marquee" style="--n: {{ section.blocks.size | plus: 1 }}" role="region" aria-label="{{ section.settings.heading | escape }}">
    <div class="marquee__track">
      {%- for pass in (1..2) -%}
        <div class="marquee__group"{% if pass == 2 %} aria-hidden="true" inert{% endif %}>
          {%- for block in section.blocks -%}
            {%- assign href = block.settings.link | default: profile -%}
            {%- case block.type -%}
              {%- when 'photo' -%}
                {%- if block.settings.image -%}
                  <a class="marquee__item" href="{{ href }}" rel="noopener" target="_blank" {% if pass == 2 %}tabindex="-1"{% endif %} {{ block.shopify_attributes }} aria-label="{{ block.settings.alt | default: 'Instagram photo' | escape }}">
                    {%- render 'image', image: block.settings.image, sizes: '40vw', widths: '360,480,640,800', alt: '' -%}
                    {%- if block.settings.caption != blank -%}<span class="marquee__cap">{{ block.settings.caption }}</span>{%- endif -%}
                  </a>
                {%- endif -%}
              {%- when 'video' -%}
                {%- assign poster = block.settings.poster | default: block.settings.video.preview_image -%}
                {%- if poster -%}
                  <a class="marquee__item marquee__item--tall" href="{{ href }}" rel="noopener" target="_blank" {% if pass == 2 %}tabindex="-1"{% endif %} {{ block.shopify_attributes }} aria-label="{{ block.settings.caption | default: 'Instagram video' | escape }}">
                    {%- render 'image', image: poster, sizes: '40vw', widths: '360,480,640,800', alt: '' -%}
                    <span class="marquee__play" aria-hidden="true"><span>{% render 'icon', name: 'play' %}</span></span>
                    {%- if block.settings.caption != blank -%}<span class="marquee__cap">{{ block.settings.caption }}</span>{%- endif -%}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Instagram marquee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Behind the pour" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen on Instagram." },
    { "type": "text", "id": "follow_text", "label": "Follow button text", "default": "Follow" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (upload originals you own)" },
      { "type": "text", "id": "alt", "label": "Alt text" },
      { "type": "text", "id": "caption", "label": "Caption (optional)" },
      { "type": "url", "id": "link", "label": "Link to a specific post (optional; defaults to your profile)" } ] },
    { "type": "video", "name": "Video thumbnail", "settings": [
      { "type": "image_picker", "id": "poster", "label": "Thumbnail image" },
      { "type": "video", "id": "video", "label": "Or a Shopify-hosted video (its preview image is used)" },
      { "type": "text", "id": "caption", "label": "Caption (optional)" },
      { "type": "url", "id": "link", "label": "Link to the reel (optional; defaults to your profile)" } ] }
  ],
  "presets": [{ "name": "Instagram marquee" }]
}
{% endschema %}
