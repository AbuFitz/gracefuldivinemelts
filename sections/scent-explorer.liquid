{%- comment -%}
  Scent explorer. Each block is a scent family whose name must match the product metafield custom.scent_family.
  Products are grouped by that metafield from the chosen collection. Without metafields the panel still shows the description and link.
{%- endcomment -%}
{%- assign col = section.settings.collection -%}
{%- assign is_page = false -%}{%- if request.page_type == 'page' -%}{%- assign is_page = true -%}{%- endif -%}
{%- if is_page -%}{%- assign head_title = section.settings.heading -%}{%- render 'page-head', title: head_title, lede: section.settings.text -%}{%- endif -%}
<section class="sheet sheet--{{ section.settings.tone }}" aria-labelledby="exp-h-{{ section.id }}">
  <div class="wrap">
    {%- if is_page -%}<h2 class="visually-hidden" id="exp-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- else -%}
    <div class="head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="exp-h-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>{%- endif -%}
    <div class="explorer" data-explorer>
      <div>
        <ul class="explorer__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <li role="presentation" {{ block.shopify_attributes }}>
              <button type="button" class="explorer__tab" role="tab" id="tab-{{ block.id }}" aria-controls="panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ block.settings.name }}</button>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <div>
        {%- for block in section.blocks -%}
          <div class="explorer__panel" role="tabpanel" id="panel-{{ block.id }}" aria-labelledby="tab-{{ block.id }}" {% unless forloop.first %}data-later{% endunless %}>
            <p class="explorer__desc">{{ block.settings.description }}</p>
            <div class="explorer__shots">
              {%- assign shown = 0 -%}
              {%- if col != blank -%}
                {%- for p in col.products -%}
                  {%- assign fam = p.metafields.custom.scent_family.value -%}
                  {%- if fam == block.settings.name and shown < 3 -%}
                    {%- assign shown = shown | plus: 1 -%}
                    <a class="explorer__shot" href="{{ p.url }}">
                      {%- if p.featured_image -%}{%- render 'image', image: p.featured_image, sizes: '(min-width: 900px) 20vw, 40vw', widths: '240,360,480,640', alt: '' -%}{%- endif -%}
                      <span>{{ p.title | escape }}<small>{% render 'price', product: p %}{% unless p.available %} · {{ 'products.sold_out' | t }}{% endunless %}</small></span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
            <p class="explorer__more"><a class="link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.cta | default: 'Shop all' }}{% render 'icon', name: 'arrow' %}</a></p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Scent explorer",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection to draw products from" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Discover by mood" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What do you like to smell?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "You can't smell a wax melt through a screen, so choose the mood and we'll show you the scents." },
    { "type": "select", "id": "tone", "label": "Background", "default": "blush", "options": [{ "value": "paper", "label": "Paper" }, { "value": "blush", "label": "Blush" }, { "value": "field", "label": "Pink" }, { "value": "ink", "label": "Dark" }] }
  ],
  "blocks": [
    { "type": "family", "name": "Scent family", "settings": [
      { "type": "text", "id": "name", "label": "Name (must match the product 'Scent family' value)", "default": "Floral" },
      { "type": "textarea", "id": "description", "label": "Description" },
      { "type": "url", "id": "link", "label": "Link (e.g. collection filtered by this family)" },
      { "type": "text", "id": "cta", "label": "Link text", "default": "Shop floral" } ] }
  ],
  "presets": [{ "name": "Scent explorer", "blocks": [
    { "type": "family", "settings": { "name": "Floral", "description": "Jasmine, rose, lily of the valley and soft musk." } },
    { "type": "family", "settings": { "name": "Sweet", "description": "Vanilla, amber, caramel and creamy musk." } },
    { "type": "family", "settings": { "name": "Woody", "description": "Leather, woods and spice." } }
  ] }]
}
{% endschema %}
