{%- assign menu = section.settings.menu | default: linklists['main-menu'] -%}
{%- assign feature = section.settings.feature_product -%}
{%- assign popular = section.settings.popular_collection -%}
<div class="nav">
  <div class="nav__bar">
    <div class="nav__left">
      <button type="button" class="pill-btn pill-btn--icon nav__menu-btn js-only" data-open-dialog="MenuDialog" aria-expanded="false" aria-controls="MenuDialog" aria-label="{{ 'general.menu.open' | t }}">{% render 'icon', name: 'menu' %}</button>
      <nav aria-label="{{ 'general.menu.main' | t }}">
        <ul class="nav__links" role="list">
          {%- for link in menu.links -%}
            {%- if link.links != blank -%}
              <li class="nav__item">
                <a class="nav__link" href="{{ link.url }}" {% if link.child_active or link.active %}aria-current="page"{% endif %} aria-haspopup="true">{{ link.title | escape }}{% render 'icon', name: 'chevron' %}</a>
                <div class="nav__panel">
                  <ul role="list">{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{%- endfor -%}</ul>
                  {%- if feature != blank and forloop.first -%}
                    <a class="nav__feature" href="{{ feature.url }}">
                      {%- if feature.featured_image -%}{%- render 'image', image: feature.featured_image, sizes: '192px', widths: '240,360,480', alt: '' -%}{%- endif -%}
                      <strong>{{ feature.title | escape }}</strong>{% render 'price', product: feature, show_from: true %}
                    </a>
                  {%- endif -%}
                </div>
              </li>
            {%- else -%}
              <li class="nav__item"><a class="nav__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
      <noscript><a class="pill-btn" href="{{ routes.all_products_collection_url }}">{{ 'general.menu.shop' | t }}</a></noscript>
    </div>

    <a class="nav__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo -%}
        {%- render 'image', image: settings.logo, sizes: '120px', widths: '160,240,320', loading: 'eager', alt: '' -%}
      {%- else -%}
        <span class="nav__wordmark">Graceful<br>Divine Melts</span>
      {%- endif -%}
    </a>

    <div class="nav__actions">
      <button type="button" class="pill-btn pill-btn--search js-only" data-open-dialog="SearchDialog" aria-expanded="false" aria-controls="SearchDialog" aria-label="{{ 'general.search.open' | t }}">{% render 'icon', name: 'search' %}<span class="nav__search-label">{{ 'general.search.nav_label' | t }}</span></button>
      <a class="pill-btn pill-btn--icon no-js-only" href="{{ routes.search_url }}" aria-label="{{ 'general.search.open' | t }}">{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}<a class="pill-btn pill-btn--icon nav__account" href="{{ routes.account_url }}" aria-label="{{ 'general.account.label' | t }}">{% render 'icon', name: 'account' %}</a>{%- endif -%}
      <a class="pill-btn pill-btn--bag" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart.label' | t }}">
        {% render 'icon', name: 'bag' %}<span class="bag-count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        <span class="visually-hidden">{{ 'general.cart.items' | t: count: cart.item_count }}</span>
      </a>
    </div>
  </div>
</div>

<dialog class="overlay" id="MenuDialog" aria-label="{{ 'general.menu.main' | t }}">
  <div class="sheetbox menu-sheet">
    <div class="menu-sheet__top">
      <span class="eyebrow" style="margin:0">{{ shop.name | escape }}</span>
      <button type="button" class="pill-btn pill-btn--icon" style="background:var(--c-blush)" data-close-dialog aria-label="{{ 'general.menu.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav aria-label="{{ 'general.menu.main' | t }}">
      <ul role="list">
        {%- for link in menu.links -%}
          <li>
            <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}{% render 'icon', name: 'right' %}</a>
            {%- if link.links != blank -%}<ul role="list">{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{%- endfor -%}</ul>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="menu-sheet__foot">
      {%- if section.settings.menu_secondary != blank -%}
        <ul role="list" style="list-style:none;display:flex;flex-wrap:wrap;gap:.25rem 1.25rem">{%- for l in section.settings.menu_secondary.links -%}<li><a href="{{ l.url }}">{{ l.title | escape }}</a></li>{%- endfor -%}</ul>
      {%- endif -%}
      {%- if settings.business_email != blank -%}<a href="mailto:{{ settings.business_email }}">{{ settings.business_email }}</a>{%- endif -%}
      <div style="color:var(--c-ink)">{%- render 'social-links' -%}</div>
    </div>
  </div>
</dialog>

<dialog class="overlay" id="SearchDialog" aria-label="{{ 'general.search.label' | t }}">
  <div class="sheetbox search-sheet">
    <form class="search-top" action="{{ routes.search_url }}" method="get" role="search" data-search-form>
      <div class="search-field">
        {% render 'icon', name: 'search' %}
        <label class="visually-hidden" for="HeaderSearch">{{ 'general.search.label' | t }}</label>
        <input id="HeaderSearch" type="search" name="q" value="" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" autocapitalize="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="SearchHits" aria-autocomplete="list" data-search-input data-autofocus>
        <button type="button" class="pill-btn pill-btn--icon search-clear" hidden data-search-clear aria-label="{{ 'general.search.clear' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>
      <input type="hidden" name="type" value="product">
      <button class="btn" type="submit">{{ 'general.search.submit' | t }}</button>
      <button class="pill-btn pill-btn--icon" type="button" style="background:var(--c-blush)" data-close-dialog aria-label="{{ 'general.search.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </form>

    <div class="search-body">
      <div data-search-shortcuts>
        <h2>{{ 'general.search.shortcuts' | t }}</h2>
        <ul class="shortcuts" role="list">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.label }}{% render 'icon', name: 'right' %}</a></li>{%- endfor -%}
        </ul>
        {%- if section.settings.search_suggestions != blank -%}
          <div class="search-chips">
            {%- assign terms = section.settings.search_suggestions | split: ',' -%}
            {%- for term in terms -%}<a class="chip" href="{{ routes.search_url }}?type=product&q={{ term | strip | url_encode }}">{{ term | strip }}</a>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div data-search-panel>
        <p class="search-status" role="status" aria-live="polite" data-search-status></p>
        {%- if popular != blank -%}
          <div data-search-popular>
            <h2>{{ 'general.search.popular' | t }}</h2>
            <div class="search-popular">
              {%- for p in popular.products limit: 3 -%}
                <a href="{{ p.url }}">{%- if p.featured_image -%}{%- render 'image', image: p.featured_image, sizes: '200px', widths: '240,360,480', alt: '' -%}{%- endif -%}{{ p.title | escape }}<br><span class="muted" style="font-weight:500">{% render 'price', product: p, show_from: true %}</span></a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        <div data-search-results></div>
      </div>
    </div>
  </div>
</dialog>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "link_list", "id": "menu_secondary", "label": "Secondary menu (shown in the mobile menu: FAQ, Contact…)" },
    { "type": "product", "id": "feature_product", "label": "Product featured in the Shop dropdown" },
    { "type": "collection", "id": "popular_collection", "label": "Collection shown as 'Popular scents' when search opens" },
    { "type": "text", "id": "search_suggestions", "label": "Search suggestions (comma separated)", "default": "Floral, Woody, Sweet, Fresh" }
  ],
  "blocks": [
    { "type": "shortcut", "name": "Search shortcut", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Shop all wax melts" },
      { "type": "url", "id": "link", "label": "Link" } ] }
  ]
}
{% endschema %}
