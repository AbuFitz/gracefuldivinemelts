<div class="wrap wrap--narrow notfound" style="text-align:center;justify-items:center">
  {%- render 'icon', name: 'wisp' -%}
  <h1 style="font-size:var(--t-h1)">{{ shop.name | escape }}</h1>
  <p class="lede">{{ 'password.text' | t }}</p>
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="StorePassword">{{ 'password.label' | t }}</label><input class="input" type="password" name="password" id="StorePassword" autocomplete="current-password" required></div>
    <p style="margin-top:var(--s-4)"><button class="btn" type="submit">{{ 'password.submit' | t }}</button></p>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password page" }
{% endschema %}
