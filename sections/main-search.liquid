{%- paginate search.results by 12 -%}
  <header class="page-head">
    <div class="wrap">
      {%- render 'breadcrumbs' -%}
      <h1>{{ 'general.search.title' | t }}</h1>
      <form class="search-top" action="{{ routes.search_url }}" method="get" role="search" style="margin-top:var(--s-6);max-width:36rem">
        <label class="visually-hidden" for="SearchPage">{{ 'general.search.label' | t }}</label>
        <input class="input" id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off">
        <input type="hidden" name="type" value="product,article,page">
        <button class="btn" type="submit">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>
  </header>
  <div class="wrap" style="padding-block:var(--s-6) var(--section-y)">
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="toolbar__count" role="status" style="margin-bottom:var(--s-6)">{{ 'general.search.results_for' | t: count: search.results_count, terms: search.terms }}</p>
        {%- assign prods = search.results | where: 'object_type', 'product' -%}
        {%- if prods.size > 0 -%}
          <ul class="catalogue catalogue--4" role="list">{%- for item in prods -%}<li>{% render 'product-card', product: item, quick_add: true %}</li>{%- endfor -%}</ul>
        {%- endif -%}
        {%- assign others = search.results | where: 'object_type', 'page' -%}
        {%- assign arts = search.results | where: 'object_type', 'article' -%}
        {%- if others.size > 0 or arts.size > 0 -%}
          <h2 style="font-size:var(--t-h3);margin:var(--s-8) 0 var(--s-4)">{{ 'general.search.other' | t }}</h2>
          <ul class="policy-list" role="list">
            {%- for item in others -%}<li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>{%- endfor -%}
            {%- for item in arts -%}<li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="empty">
          <h2>{{ 'general.search.no_results_title' | t: terms: search.terms }}</h2>
          <p class="muted">{{ 'general.search.no_results_text' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'general.search.browse_all' | t }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="empty"><p class="muted">{{ 'general.search.prompt' | t }}</p></div>
    {%- endif -%}
  </div>
{%- endpaginate -%}
{% schema %}
{ "name": "Search results" }
{% endschema %}
