{%- comment -%}
  Pick a scent: ONE section that blends the V2 "Discover by mood" idea with the product rail.
  - The rail shows real products from a collection (restrained frames, quick add).
  - Mood tabs appear only for families that real products carry in the metafield custom.scent_family; picking one filters the rail
    to those products and shows the family's description and link. No tabs are shown if there is no matching metadata.
{%- endcomment -%}
{%- assign col = section.settings.collection -%}
{%- assign is_page = false -%}
{%- if request.page_type == 'page' and section.blocks.size > 0 -%}{%- assign is_page = true -%}{%- endif -%}
{%- if is_page -%}{%- assign head_title = section.settings.heading -%}{%- render 'page-head', title: head_title, lede: section.settings.text -%}{%- endif -%}
<section class="sheet sheet--{{ section.settings.tone }}{% if section.settings.curve != 'dome' %} sheet--{{ section.settings.curve }}{% endif %}" aria-labelledby="rail-h-{{ section.id }}" data-rail-section>
  <div class="wrap">
    <div class="head">
      <div>
        {%- if is_page -%}<h2 class="visually-hidden" id="rail-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- else -%}
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 id="rail-h-{{ section.id }}">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- endif -%}
      </div>
      <div style="display:flex;gap:var(--s-5);align-items:center">
        {%- if col != blank -%}<a class="link" href="{{ col.url }}">{{ 'sections.featured.view_all' | t }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        <div class="rail-ctl js-only">
          <button type="button" class="round-btn" data-rail-prev aria-label="{{ 'general.rail.previous' | t }}">{% render 'icon', name: 'left' %}</button>
          <button type="button" class="round-btn" data-rail-next aria-label="{{ 'general.rail.next' | t }}">{% render 'icon', name: 'right' %}</button>
        </div>
      </div>
    </div>

    {%- if col != blank and section.blocks.size > 0 -%}
      {%- capture mood_tabs -%}
        {%- for block in section.blocks -%}
          {%- assign hits = 0 -%}
          {%- for p in col.products limit: section.settings.limit -%}{%- if p.metafields.custom.scent_family.value == block.settings.name -%}{%- assign hits = hits | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- if hits > 0 -%}<button type="button" class="moods__tab" aria-pressed="false" data-mood="{{ block.settings.name | escape }}" data-desc="{{ block.settings.description | escape }}" data-link="{{ block.settings.link }}" data-cta="{{ block.settings.cta | escape }}" {{ block.shopify_attributes }}>{{ block.settings.name }}</button>{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if mood_tabs contains 'moods__tab' -%}
        <div class="moods js-only" data-moods>
          <div class="moods__tabs" role="group" aria-label="{{ 'sections.selector.families' | t }}">
            <button type="button" class="moods__tab" aria-pressed="true" data-mood="">{{ 'sections.selector.all' | t }}</button>
            {{ mood_tabs }}
          </div>
          <p class="moods__desc" data-moods-desc aria-live="polite"></p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if col != blank and col.products.size > 0 -%}
    <ul class="rail rail--stagger" role="list" data-rail tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {%- for product in col.products limit: section.settings.limit -%}
        <li data-reveal data-family="{{ product.metafields.custom.scent_family.value | escape }}">{% render 'product-card', product: product, quick_add: section.settings.quick_add, sizes: '(min-width: 900px) 24vw, 62vw' %}</li>
      {%- endfor -%}
    </ul>
  {%- elsif col != blank -%}
    <div class="wrap"><div class="empty"><p>{{ 'collections.empty' | t }}</p></div></div>
  {%- else -%}
    <div class="wrap"><div class="placeholder-box">{{ 'sections.featured.choose' | t }}</div></div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Pick a scent",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The scents" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a scent." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "range", "id": "limit", "min": 3, "max": 16, "step": 1, "label": "Products to show", "default": 12 },
    { "type": "checkbox", "id": "quick_add", "label": "Quick add (single-variant products)", "default": true },
    { "type": "select", "id": "tone", "label": "Background", "default": "blush", "options": [{ "value": "paper", "label": "Paper" }, { "value": "blush", "label": "Blush" }, { "value": "field", "label": "Pink" }] },
    { "type": "select", "id": "curve", "label": "Top edge", "default": "swell", "options": [{ "value": "swell", "label": "Soft swell" }, { "value": "dome", "label": "Dome" }, { "value": "flat", "label": "Flat" }] }
  ],
  "blocks": [
    { "type": "mood", "name": "Mood (scent family)", "settings": [
      { "type": "text", "id": "name", "label": "Name (must match the product 'Scent family' value)", "default": "Floral" },
      { "type": "textarea", "id": "description", "label": "Description" },
      { "type": "url", "id": "link", "label": "Link (e.g. a collection for this family)" },
      { "type": "text", "id": "cta", "label": "Link text", "default": "Shop all" } ] }
  ],
  "presets": [{ "name": "Pick a scent", "blocks": [
    { "type": "mood", "settings": { "name": "Floral", "description": "Jasmine, rose, lily of the valley and soft musk." } },
    { "type": "mood", "settings": { "name": "Sweet", "description": "Vanilla, amber, caramel and creamy musk." } },
    { "type": "mood", "settings": { "name": "Woody", "description": "Leather, woods and spice." } }
  ] }]
}
{% endschema %}
