{%- comment -%}
  Grouped FAQ. Blocks are processed in order: a "Group heading" block starts a new group; "Question" blocks belong to the group above.
{%- endcomment -%}
{%- assign head_title = page.title | default: section.settings.heading | escape -%}
{%- render 'page-head', title: head_title, lede: section.settings.lede -%}
<div class="wrap" style="padding-block:var(--s-7) var(--section-y)">
  <div class="faq-layout">
    <nav class="faq-nav" aria-label="{{ 'faq.topics' | t }}">
      <ul role="list">
        {%- for block in section.blocks -%}{%- if block.type == 'group' -%}<li><a class="chip" href="#g-{{ block.id }}">{{ block.settings.title | escape }}</a></li>{%- endif -%}{%- endfor -%}
      </ul>
    </nav>
    <div>
      <div class="accordion faq-flat">
        {%- for block in section.blocks -%}
          {%- if block.type == 'group' -%}
            <h2 class="faq-group-h" id="g-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</h2>
          {%- else -%}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="accordion__body">{{ block.settings.answer }}</div></details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="notice notice--info" style="margin-top:var(--s-8)">
        <p><strong>{{ 'faq.still_need' | t }}</strong> <a href="{{ section.settings.contact_link | default: routes.root_url }}">{{ 'faq.contact' | t }}</a></p>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "FAQ page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Questions" },
    { "type": "textarea", "id": "lede", "label": "Intro" },
    { "type": "url", "id": "contact_link", "label": "Contact page link" }
  ],
  "blocks": [
    { "type": "group", "name": "Group heading", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Care & use" }] },
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" } ] }
  ]
}
{% endschema %}
