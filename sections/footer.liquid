<footer class="footer">
  <div class="wrap">
    <div class="footer__lead">
      <h2>{{ section.settings.heading }}</h2>
      <div>
        {%- if section.settings.blurb != blank -%}<p style="max-width:26rem;color:rgb(255 255 255 / .78);margin-bottom:var(--s-6)">{{ section.settings.blurb }}</p>{%- endif -%}
        <div class="footer__cols">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'links' -%}
                <nav {{ block.shopify_attributes }} aria-labelledby="f-{{ block.id }}">
                  <h3 id="f-{{ block.id }}">{{ block.settings.heading }}</h3>
                  <ul role="list">{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}</ul>
                </nav>
              {%- when 'contact' -%}
                <div {{ block.shopify_attributes }}>
                  <h3>{{ block.settings.heading }}</h3>
                  <ul role="list">
                    {%- if settings.business_email != blank -%}<li><a href="mailto:{{ settings.business_email }}">{{ settings.business_email | replace: '@', '<wbr>@' }}</a></li>{%- endif -%}
                    {%- if settings.business_phone != blank -%}<li><span>{{ settings.business_phone }}</span></li>{%- endif -%}
                    {%- if settings.business_hours != blank -%}<li><span>{{ settings.business_hours }}</span></li>{%- endif -%}
                  </ul>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', class: 'newsletter', id: 'FooterNewsletter', style: 'margin-top:var(--s-6)' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="notice notice--ok" role="status">{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
              <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
              <div class="newsletter__row">
                <input class="input" id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}" {% if form.errors %}aria-invalid="true"{% endif %}>
                <button class="btn" type="submit">{{ 'newsletter.submit' | t }}</button>
              </div>
              <p class="field-hint" style="color:rgb(255 255 255 / .7)">{{ 'newsletter.consent' | t }} <a href="{{ routes.privacy_policy_url }}" style="text-decoration:underline">{{ 'footer.privacy' | t }}</a>.</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>

    <div class="footer__find">
      <p>{{ section.settings.find_text }}</p>
      {%- render 'social-links' -%}
    </div>

    <div class="footer__legal">
      <div>
        <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.business_legal_name | default: shop.name | escape }}.</span>
        {%- if settings.company_number != blank %} {{ 'footer.company_number' | t: number: settings.company_number }}.{% endif -%}
        {%- if settings.vat_number != blank %} {{ 'footer.vat_number' | t: number: settings.vat_number }}.{% endif -%}
        {%- if settings.business_address != blank %}<br>{{ settings.business_address | newline_to_br }}{% endif -%}
      </div>
      <ul role="list" aria-label="{{ 'footer.policies' | t }}">
        {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}
        {%- if section.settings.legal_menu != blank -%}{%- for link in section.settings.legal_menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}{%- endif -%}
        <li class="js-only"><button type="button" data-cookie-prefs>{{ 'footer.cookie_preferences' | t }}</button></li>
      </ul>
      {%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
        <ul class="payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
  <p class="footer__mark" aria-hidden="true">{%- assign words = shop.name | split: ' ' -%}{%- for w in words -%}<span>{{ w | escape }}</span> {% endfor -%}</p>
</footer>
{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Closing line", "default": "Poured with intention, inspired by grace." },
    { "type": "textarea", "id": "blurb", "label": "Text", "default": "Perfume-inspired wax melts. UK based." },
    { "type": "text", "id": "find_text", "label": "Line beside the profile icons", "default": "Find us, and tell us what you think" },
    { "type": "checkbox", "id": "show_payments", "label": "Show the payment methods enabled in Shopify (Settings → Payments)", "default": true },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter sign-up (only once you have decided how emails are sent)", "default": false },
    { "type": "link_list", "id": "legal_menu", "label": "Extra legal links (e.g. Delivery & returns)" }
  ],
  "blocks": [
    { "type": "links", "name": "Link list", "limit": 2, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" } ] },
    { "type": "contact", "name": "Contact", "limit": 1, "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us" }] }
  ]
}
{% endschema %}
