<aside class="cookiebar" data-cookie-consent hidden aria-labelledby="CookieTitle">
  <div class="cookiebar__inner">
    <div>
      <h2 id="CookieTitle">{{ 'cookies.banner_title' | t }}</h2>
      <p>{{ 'cookies.banner_text' | t }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ 'cookies.read_privacy' | t }}</a>.</p>
    </div>
    <div class="cookiebar__actions">
      <button class="btn btn--ghost" type="button" data-cookie-reject>{{ 'cookies.reject' | t }}</button>
      <button class="btn btn--ghost" type="button" data-cookie-manage>{{ 'cookies.manage' | t }}</button>
      <button class="btn" type="button" data-cookie-accept>{{ 'cookies.accept' | t }}</button>
    </div>
  </div>
</aside>

<dialog class="overlay" id="CookiePreferences" aria-labelledby="CookiePreferencesTitle">
  <div class="sheetbox cookie-sheet">
    <div class="cookie-sheet__top">
      <span class="eyebrow">{{ 'cookies.eyebrow' | t }}</span>
      <button class="pill-btn pill-btn--icon" type="button" data-close-dialog aria-label="{{ 'cookies.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <h2 id="CookiePreferencesTitle">{{ 'cookies.title' | t }}</h2>
    <p>{{ 'cookies.intro' | t }}</p>
    <ul class="cookie-options" role="list">
      <li class="cookie-option">
        <div><strong>{{ 'cookies.essential' | t }}</strong><span>{{ 'cookies.essential_text' | t }}</span></div>
        <input type="checkbox" checked disabled aria-label="{{ 'cookies.essential_label' | t }}">
      </li>
      <li class="cookie-option">
        <label for="CookiePreferencesToggle"><strong>{{ 'cookies.preferences' | t }}</strong><span>{{ 'cookies.preferences_text' | t }}</span></label>
        <input id="CookiePreferencesToggle" type="checkbox" data-cookie-choice="preferences">
      </li>
      <li class="cookie-option">
        <label for="CookieAnalyticsToggle"><strong>{{ 'cookies.analytics' | t }}</strong><span>{{ 'cookies.analytics_text' | t }}</span></label>
        <input id="CookieAnalyticsToggle" type="checkbox" data-cookie-choice="analytics">
      </li>
      <li class="cookie-option">
        <label for="CookieMarketingToggle"><strong>{{ 'cookies.marketing' | t }}</strong><span>{{ 'cookies.marketing_text' | t }}</span></label>
        <input id="CookieMarketingToggle" type="checkbox" data-cookie-choice="marketing">
      </li>
    </ul>
    <div class="cookie-sheet__actions">
      <button class="btn" type="button" data-cookie-save>{{ 'cookies.save' | t }}</button>
      <button class="btn btn--ghost" type="button" data-cookie-accept>{{ 'cookies.accept' | t }}</button>
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "Cookie consent",
  "settings": []
}
{% endschema %}
