<div class="wrap">
  <header class="page-head" style="border:0"><h1 style="font-size:var(--t-h2)">{{ 'customer.account.title' | t }}</h1><p class="lede">{{ 'customer.account.welcome' | t: name: customer.first_name | default: customer.email }}</p></header>
  <div class="account">
    <div>
      <h2 style="font-size:var(--t-h3);margin-bottom:var(--s-4)">{{ 'customer.orders.title' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-wrap"><table class="table">
            <thead><tr><th scope="col">{{ 'customer.orders.order' | t }}</th><th scope="col">{{ 'customer.orders.date' | t }}</th><th scope="col">{{ 'customer.orders.payment' | t }}</th><th scope="col">{{ 'customer.orders.fulfilment' | t }}</th><th scope="col">{{ 'customer.orders.total' | t }}</th></tr></thead>
            <tbody>{%- for order in customer.orders -%}
              <tr><th scope="row"><a href="{{ order.customer_url }}">{{ order.name }}</a></th><td>{{ order.created_at | time_tag: '%d %b %Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money }}</td></tr>
            {%- endfor -%}</tbody>
          </table></div>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <div class="empty" style="text-align:left;margin:0"><p class="muted">{{ 'customer.orders.none' | t }}</p><a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty.cta' | t }}</a></div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <aside>
      <h2 style="font-size:var(--t-h3);margin-bottom:var(--s-4)">{{ 'customer.account.details' | t }}</h2>
      <p>{{ customer.name }}<br>{{ customer.email }}</p>
      {%- if customer.default_address -%}<p>{{ customer.default_address | format_address }}</p>{%- endif -%}
      <p><a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a></p>
      <p style="margin-top:var(--s-5)"><a class="btn btn--ghost" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a></p>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "Account" }
{% endschema %}
