{%- if request.page_type == 'page' -%}
  <header class="page-head page-head--blush">
    <div class="container">
      {%- render 'breadcrumbs' -%}
      <h1 id="fam-h-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </header>
{%- endif -%}
<section class="section" aria-labelledby="fam-h-{{ section.id }}">
  <div class="container">
    {%- if request.page_type != 'page' -%}
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="fam-h-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="families" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="family" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
              <span class="family__name">{{ block.settings.name }}</span>
              <span class="family__desc">{{ block.settings.description }}</span>
              <span class="family__go">{{ block.settings.cta | default: 'Shop' }} {% render 'icon', name: 'arrow' %}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Scent families",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Choose by mood" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the scent that fits your space." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "You can't smell a wax melt through a screen, so we describe each fragrance by its notes and family." }
  ],
  "blocks": [
    {
      "type": "family", "name": "Scent family",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Floral" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Soft blooms, jasmine and rose." },
        { "type": "url", "id": "link", "label": "Link (collection, filtered collection or search)" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Shop floral" }
      ]
    }
  ],
  "presets": [
    { "name": "Scent families", "blocks": [
      { "type": "family", "settings": { "name": "Floral & fresh", "description": "Jasmine, rose, lily of the valley and citrus." } },
      { "type": "family", "settings": { "name": "Sweet & warm", "description": "Vanilla, amber, caramel and musk." } },
      { "type": "family", "settings": { "name": "Woody & bold", "description": "Leather, woods and spice." } }
    ] }
  ]
}
{% endschema %}
