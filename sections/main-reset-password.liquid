<div class="container container--narrow" style="padding-block:var(--s-8) var(--section-y)">
  <h1 style="font-size:var(--t-h2);margin-bottom:var(--s-6)">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="RP1">{{ 'customer.password' | t }}</label><input class="input" type="password" name="customer[password]" id="RP1" autocomplete="new-password" required></div>
    <div class="field"><label for="RP2">{{ 'customer.reset.confirm' | t }}</label><input class="input" type="password" name="customer[password_confirmation]" id="RP2" autocomplete="new-password" required></div>
    <p style="margin-top:var(--s-5)"><button class="btn" type="submit">{{ 'customer.reset.submit' | t }}</button></p>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Reset password" }
{% endschema %}
