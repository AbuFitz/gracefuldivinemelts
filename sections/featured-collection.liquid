{%- assign col = section.settings.collection -%}
<section class="section{% if section.settings.tint %} section--blush{% endif %}" aria-labelledby="fc-h-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="fc-h-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if col != blank -%}<a class="link-arrow" href="{{ col.url }}">{{ 'sections.featured.view_all' | t }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
    {%- if col != blank and col.products.size > 0 -%}
      <ul class="grid {% if section.settings.columns == '4' %}grid--4{% endif %}" role="list">
        {%- for product in col.products limit: section.settings.limit -%}
          <li data-reveal>{% render 'product-card', product: product, quick_add: section.settings.quick_add %}</li>
        {%- endfor -%}
      </ul>
    {%- elsif col != blank -%}
      <div class="empty"><p>{{ 'collections.empty' | t }}</p></div>
    {%- else -%}
      {%- comment -%} Theme-editor placeholder only; the live homepage has a real collection assigned. {%- endcomment -%}
      <div class="placeholder-box">{{ 'sections.featured.choose' | t }}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our wax melts" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "select", "id": "columns", "label": "Columns on large screens", "default": "4", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "checkbox", "id": "quick_add", "label": "Show quick add (single-variant products only)", "default": true },
    { "type": "checkbox", "id": "tint", "label": "Blush background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
