{%- if section.settings.text != blank -%}
<div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
  <div class="container">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Handmade wax melts · Jeremiah 29:11" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ]
}
{% endschema %}
