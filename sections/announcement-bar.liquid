{%- comment -%}
  Announcement bar: messages roll upwards one at a time (automatic, no arrows). Every message stays in the page, so with JavaScript
  off or reduced motion the bar simply shows the first one (reduced motion shows all in a calm static row if there is room).
  The rolling pauses while the pointer or keyboard focus is on it, and while the tab is hidden.
{%- endcomment -%}
{%- assign msgs = section.blocks | where: 'type', 'message' -%}
{%- if msgs.size > 0 -%}
<div class="announce" role="region" aria-label="{{ 'sections.announcement.label' | t }}" data-announce data-interval="{{ section.settings.seconds }}">
  <div class="announce__viewport">
    <ul class="announce__track" role="list">
      {%- for block in msgs -%}
        <li class="announce__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}<span>{{ block.settings.text }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "settings": [
    { "type": "range", "id": "seconds", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Time on each message", "default": 5 }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Message", "default": "Poured with intention, inspired by grace" },
      { "type": "url", "id": "link", "label": "Link (optional)" } ] }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
