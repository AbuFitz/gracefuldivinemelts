{%- if section.settings.quote != blank -%}
<section class="section" aria-label="{{ 'sections.quote.label' | t }}">
  <div class="container">
    <figure class="quote">
      {%- render 'icon', name: 'wisp' -%}
      <blockquote>&ldquo;{{ section.settings.quote }}&rdquo;</blockquote>
      <figcaption>{{ section.settings.source }}{%- if settings.review_link != blank and section.settings.show_review_link %} · <a href="{{ settings.review_link }}" rel="noopener" target="_blank">{{ 'sections.quote.read_reviews' | t }}</a>{% endif -%}</figcaption>
    </figure>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Customer quote",
  "settings": [
    { "type": "paragraph", "content": "Only use a quote a real customer has given you permission to publish. Leave the quote empty to hide this section." },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "source", "label": "Attribution (e.g. 'Verified customer, Trustpilot')" },
    { "type": "checkbox", "id": "show_review_link", "label": "Link to review page", "default": true }
  ],
  "presets": [{ "name": "Customer quote" }]
}
{% endschema %}
