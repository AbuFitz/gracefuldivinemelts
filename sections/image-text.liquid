<section class="section" aria-labelledby="it-h-{{ section.id }}">
  <div class="wrap">
    <div class="split{% if section.settings.flip %} split--flip{% endif %}">
      <div class="split__media" data-reveal>
        {%- if section.settings.image -%}{%- render 'image', image: section.settings.image, sizes: '(min-width: 860px) 50vw, 100vw', widths: '480,720,960,1280' -%}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
      </div>
      <div class="split__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="it-h-{{ section.id }}">{{ section.settings.heading }}</h2>
        <div class="prose">{{ section.settings.text }}</div>
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}<a class="link" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made in small batches." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our wax melts are carefully prepared in small batches with care and attention to quality.</p>" },
    { "type": "text", "id": "cta_label", "label": "Link text" },
    { "type": "url", "id": "cta_link", "label": "Link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
