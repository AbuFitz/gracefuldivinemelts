{%- if section.blocks.size > 0 -%}
<section class="section--tight section {% if section.settings.dark %}section--ink{% else %}section--blush{% endif %}" aria-label="{{ 'sections.usp.label' | t }}">
  <div class="container">
    <ul class="usp" role="list" style="--cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3>{%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Key points",
  "max_blocks": 4,
  "settings": [{ "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Handmade" },
      { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "presets": [{ "name": "Key points", "blocks": [
    { "type": "point", "settings": { "title": "Handmade", "text": "Prepared in small batches." } },
    { "type": "point", "settings": { "title": "Perfume-inspired", "text": "Scents inspired by popular luxury fragrances." } },
    { "type": "point", "settings": { "title": "Not sure?", "text": "Try the Mixed Scent Package." } }
  ] }]
}
{% endschema %}
