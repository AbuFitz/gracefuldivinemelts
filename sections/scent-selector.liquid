{%- comment -%}
  Scent selector: real products from a collection, with their real notes, price and add-to-bag.
  Family chips appear only when the products actually carry the metafield custom.scent_family.
{%- endcomment -%}
{%- assign col = section.settings.collection -%}
{%- assign fam_list = '' -%}
{%- if col != blank -%}
  {%- for p in col.products limit: section.settings.limit -%}
    {%- assign f = p.metafields.custom.scent_family.value -%}
    {%- if f != blank -%}{%- unless fam_list contains f -%}{%- assign fam_list = fam_list | append: f | append: '|' -%}{%- endunless -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign families = fam_list | split: '|' -%}
{%- assign is_page = false -%}
{%- if request.page_type == 'page' -%}{%- assign is_page = true -%}{%- endif -%}
{%- if is_page -%}{%- assign head_title = section.settings.heading -%}{%- render 'page-head', title: head_title, lede: section.settings.text -%}{%- endif -%}
<section class="sheet sheet--{{ section.settings.tone }}" aria-labelledby="sel-h-{{ section.id }}">
  <div class="wrap">
    {%- if is_page -%}<h2 class="visually-hidden" id="sel-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- else -%}
    <div class="head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="sel-h-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>{%- endif -%}

    {%- if col != blank and col.products.size > 0 -%}
    <div class="selector" data-selector>
      <div class="js-only">
        {%- if families.size > 1 -%}
          <div class="selector__families" role="group" aria-label="{{ 'sections.selector.families' | t }}">
            <button type="button" class="chip" aria-pressed="true" data-family="">{{ 'sections.selector.all' | t }}</button>
            {%- for f in families -%}<button type="button" class="chip" aria-pressed="false" data-family="{{ f | escape }}">{{ f | escape }}</button>{%- endfor -%}
          </div>
        {%- endif -%}
        <ul class="selector__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for p in col.products limit: section.settings.limit -%}
            {%- assign f = p.metafields.custom.scent_family.value -%}
            <li role="presentation" data-family="{{ f | escape }}">
              <button type="button" class="selector__row{% unless p.available %} is-out{% endunless %}" role="tab" id="selrow-{{ section.id }}-{{ forloop.index }}" aria-controls="selpanel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ p.title | escape }}{% if f != blank %}<small>{{ f }}</small>{% endif %}</button>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="selector__stage">
        {%- for p in col.products limit: section.settings.limit -%}
          {%- assign f = p.metafields.custom.scent_family.value -%}
          {%- assign inspired = p.metafields.custom.inspired_by.value -%}
          <div class="selector__panel" role="tabpanel" id="selpanel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="selrow-{{ section.id }}-{{ forloop.index }}" data-family="{{ f | escape }}">
            <a class="selector__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{%- if p.featured_image -%}{%- render 'image', image: p.featured_image, sizes: '(min-width: 900px) 28vw, 90vw', widths: '480,720,960,1280', alt: '' -%}{%- endif -%}</a>
            <div class="selector__info">
              {%- if f != blank -%}<p class="selector__fam">{{ f }}</p>{%- endif -%}
              <h3>{{ p.title | escape }}</h3>
              {%- render 'scent-notes', product: p -%}
              {%- if inspired != blank -%}<p class="selector__inspired">{{ 'products.inspired_by' | t: name: inspired }}</p>{%- endif -%}
              <p class="selector__price">{% render 'price', product: p, show_from: true %}{% unless p.available %} <span class="muted" style="font-size:var(--t-sm);font-weight:500">· {{ 'products.sold_out' | t }}</span>{% endunless %}</p>
              <div class="selector__actions">
                {%- if p.variants.size == 1 and p.available -%}
                  {%- form 'product', p, class: 'js-quick-add' -%}<input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><button type="submit" class="btn">{{ 'products.add_to_cart' | t }}</button>{%- endform -%}
                {%- endif -%}
                <a class="btn btn--ghost" href="{{ p.url }}">{{ 'sections.hero.view' | t }}<span class="visually-hidden"> {{ p.title | escape }}</span></a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
    {%- else -%}
      <div class="placeholder-box">{{ 'sections.featured.choose' | t }}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Scent selector",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (real products)" },
    { "type": "range", "id": "limit", "min": 3, "max": 14, "step": 1, "label": "Products", "default": 10 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Find your scent" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Smell it before you buy it." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick a scent to see its notes, then add it straight to your bag." },
    { "type": "select", "id": "tone", "label": "Background", "default": "blush", "options": [{ "value": "paper", "label": "Paper" }, { "value": "blush", "label": "Blush" }, { "value": "field", "label": "Pink" }] }
  ],
  "presets": [{ "name": "Scent selector" }]
}
{% endschema %}
