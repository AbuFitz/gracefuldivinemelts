<section class="section sheet sheet--blush" aria-labelledby="nl-h-{{ section.id }}">
  <div class="wrap wrap--narrow" style="text-align:center">
    <h2 id="nl-h-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lede" style="margin:var(--s-4) auto var(--s-6)">{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', id: 'SectionNewsletter', style: 'max-width:32rem;margin:0 auto;text-align:left' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="notice notice--ok" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="SecNewsletterEmail">{{ 'newsletter.email' | t }}</label>
          <div style="display:flex;gap:var(--s-2);flex-wrap:wrap">
            <input class="input" style="flex:1 1 14rem;width:auto" id="SecNewsletterEmail" type="email" name="contact[email]" autocomplete="email" required {% if form.errors %}aria-invalid="true"{% endif %}>
            <button class="btn" type="submit">{{ 'newsletter.submit' | t }}</button>
          </div>
          <span class="field-hint">{{ 'newsletter.consent' | t }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ 'footer.privacy' | t }}</a>.</span>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our community" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sign up for discount codes, new scents and restocks." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
