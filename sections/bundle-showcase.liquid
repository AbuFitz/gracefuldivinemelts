{%- assign p = section.settings.product -%}
{%- if p != blank -%}
<section class="sheet sheet--{{ section.settings.tone }}{% if section.settings.curve != 'dome' %} sheet--{{ section.settings.curve }}{% endif %}" aria-labelledby="bun-h-{{ section.id }}">
  <div class="wrap">
    <div class="bundle">
      <div class="bundle__stage">
        <div class="bundle__img">
          {%- if section.settings.image -%}{%- render 'image', image: section.settings.image, sizes: '(min-width: 900px) 55vw, 100vw', widths: '480,720,960,1280' -%}
          {%- elsif p.featured_image -%}{%- render 'image', image: p.featured_image, sizes: '(min-width: 900px) 55vw, 100vw', widths: '480,720,960,1280' -%}{%- endif -%}
        </div>
        {%- assign pin_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'pin' -%}{%- assign pin_n = pin_n | plus: 1 -%}<span class="pin" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%" {{ block.shopify_attributes }}><b>{{ pin_n }}</b>{{ block.settings.label }}</span>{%- endif -%}
        {%- endfor -%}
      </div>
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="bun-h-{{ section.id }}">{{ section.settings.heading | default: p.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede" style="margin-top:var(--s-4)">{{ section.settings.text }}</p>{%- endif -%}
        <ul class="bundle__list" role="list">
          {%- for block in section.blocks -%}{%- if block.type == 'include' -%}<li {{ block.shopify_attributes }}><b>{{ block.settings.qty }}</b>{{ block.settings.item }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        {%- assign scent_blocks = section.blocks | where: 'type', 'scent' -%}
        {%- if scent_blocks.size > 0 -%}
          <p class="label">{{ section.settings.scents_label }}</p>
          <div class="dots">
            {%- for block in scent_blocks -%}
              {%- assign sp = block.settings.product -%}
              {%- if sp != blank -%}<a class="dot" href="{{ sp.url }}" {{ block.shopify_attributes }}>{%- if sp.featured_image -%}{%- render 'image', image: sp.featured_image, sizes: '64px', widths: '128,192', alt: '' -%}{%- endif -%}{{ sp.title | escape }}</a>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <p class="bundle__price">{% render 'price', product: p, show_from: true %}</p>
        <a class="btn" href="{{ p.url }}">{{ section.settings.cta | default: 'Choose your pair' }}{% render 'icon', name: 'arrow' %}</a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Bundle showcase",
  "settings": [
    { "type": "product", "id": "product", "label": "Bundle product" },
    { "type": "image_picker", "id": "image", "label": "Image (defaults to the product image)" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The bundle" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "scents_label", "label": "Label above the scents", "default": "Choose any two of these scents" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Choose your pair" },
    { "type": "select", "id": "curve", "label": "Top edge", "default": "flat", "options": [{ "value": "dome", "label": "Dome" }, { "value": "swell", "label": "Soft swell" }, { "value": "flat", "label": "Flat" }] },
    { "type": "select", "id": "tone", "label": "Background", "default": "field", "options": [{ "value": "paper", "label": "Paper" }, { "value": "blush", "label": "Blush" }, { "value": "field", "label": "Pink" }] }
  ],
  "blocks": [
    { "type": "include", "name": "What's included", "settings": [
      { "type": "text", "id": "qty", "label": "Quantity", "default": "2" }, { "type": "text", "id": "item", "label": "Item", "default": "wax melt snap bars of your choice" } ] },
    { "type": "scent", "name": "Scent thumbnail", "settings": [{ "type": "product", "id": "product", "label": "Product" }] },
    { "type": "pin", "name": "Image label", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "range", "id": "x", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Horizontal", "default": 50 },
      { "type": "range", "id": "y", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Vertical", "default": 50 } ] }
  ],
  "presets": [{ "name": "Bundle showcase" }]
}
{% endschema %}
