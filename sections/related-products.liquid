{%- liquid
  assign recs = recommendations.products
  assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=related'
-%}
<section class="section related" data-recommendations data-url="{{ rec_url }}" aria-labelledby="rel-h-{{ section.id }}">
  <div class="wrap">
    {%- if recommendations.performed and recs.size > 0 or section.settings.fallback != blank -%}
      <div class="head"><div><h2 id="rel-h-{{ section.id }}" style="font-size:var(--t-h3)">{{ section.settings.heading }}</h2></div></div>
      <ul class="catalogue catalogue--4" role="list">
        {%- if recommendations.performed and recs.size > 0 -%}
          {%- for p in recs limit: section.settings.limit -%}<li>{% render 'product-card', product: p, quick_add: true %}</li>{%- endfor -%}
        {%- else -%}
          {%- assign shown = 0 -%}
          {%- for p in section.settings.fallback.products -%}
            {%- if p.id != product.id and shown < section.settings.limit -%}{%- assign shown = shown | plus: 1 -%}<li>{% render 'product-card', product: p, quick_add: true %}</li>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Related scents",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "fallback", "label": "Fallback collection (shown if Shopify has no recommendations yet)" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ],
  "presets": [{ "name": "Related scents" }]
}
{% endschema %}
