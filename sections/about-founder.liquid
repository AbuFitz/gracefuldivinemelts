{%- comment -%}
  About page: founder introduction + her own words + the work (photo mosaic) + follow.
  The founder's words are her own, written for her TikTok/Shop profile. Edit them in the theme editor; do not add claims she has not made.
{%- endcomment -%}
{%- assign shots = section.blocks | where: 'type', 'photo' -%}
<section class="founder" aria-labelledby="founder-h-{{ section.id }}">
  <div class="founder__hero">
    <div class="wrap founder__grid">
      <div class="founder__intro">
        {%- render 'breadcrumbs' -%}
        <h1 id="founder-h-{{ section.id }}">{{ section.settings.heading }}</h1>
        {%- if section.settings.role != blank -%}<p class="founder__role">{{ section.settings.role }}</p>{%- endif -%}
        <div class="founder__cta">
          <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}{% render 'icon', name: 'arrow' %}</a>
          {%- if settings.social_tiktok != blank -%}<a class="btn btn--ghost" href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">{% render 'brand-icon', name: 'tiktok' %}<span>@{{ settings.tiktok_handle }}</span></a>{%- endif -%}
        </div>
      </div>
      <div class="founder__media">
        <figure class="founder__portrait">
          {%- if section.settings.portrait -%}{%- render 'image', image: section.settings.portrait, sizes: '(min-width: 900px) 34vw, 78vw', widths: '480,720,960', alt: section.settings.portrait_alt, eager: true -%}{%- else -%}<div class="founder__placeholder" aria-hidden="true"></div>{%- endif -%}
        </figure>
        {%- if section.settings.orb -%}<figure class="founder__orb">{%- render 'image', image: section.settings.orb, sizes: '14rem', widths: '240,360,480', alt: '' -%}</figure>{%- endif -%}
        <p class="founder__tag"><b>{{ section.settings.heading | remove: "Hi, I'm " | remove: '.' }}</b><span>{{ section.settings.tag }}</span></p>
      </div>
    </div>
  </div>

  <div class="sheet sheet--paper sheet--swell founder__words">
    <div class="wrap">
      <div class="founder__note">
        <p class="eyebrow">{{ section.settings.note_label }}</p>
        {%- liquid
          assign q = section.settings.quote | escape
          if section.settings.highlight != blank
            assign hl = section.settings.highlight | escape
            assign rep = '<span>' | append: hl | append: '</span>'
            assign q = q | replace: hl, rep
          endif
        -%}
        <blockquote class="founder__quote"><p>{{ q }}</p></blockquote>
        {%- if section.settings.text != blank -%}<div class="prose founder__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.signature != blank -%}<p class="founder__sign">{{ section.settings.signature }}</p>{%- endif -%}
      </div>

      {%- if section.settings.fact_1 != blank -%}
        <ul class="founder__facts" role="list">
          {%- for i in (1..3) -%}
            {%- assign key = 'fact_' | append: i -%}
            {%- if section.settings[key] != blank -%}<li>{{ section.settings[key] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if shots.size > 0 -%}
        <div class="founder__work">
          <h2>{{ section.settings.work_heading }}</h2>
          <ul class="founder__mosaic" role="list">
            {%- for block in shots -%}
              {%- if block.settings.image -%}
                <li {{ block.shopify_attributes }}>{%- render 'image', image: block.settings.image, sizes: '(min-width: 900px) 24vw, 46vw', widths: '360,540,720', alt: block.settings.alt -%}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="founder__follow">
        <p>{{ section.settings.follow_text }}</p>
        <div class="showcase__follow">
          {%- if settings.social_tiktok != blank -%}<a class="btn" href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">{% render 'brand-icon', name: 'tiktok' %}<span>TikTok</span></a>{%- endif -%}
          {%- if settings.social_instagram != blank -%}<a class="btn btn--ghost" href="{{ settings.social_instagram }}" rel="noopener" target="_blank">{% render 'brand-icon', name: 'instagram' %}<span>Instagram</span></a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Founder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hi, I'm Tamara." },
    { "type": "text", "id": "role", "label": "Role line", "default": "Founder of Graceful Divine Melts" },
    { "type": "text", "id": "tag", "label": "Name tag line", "default": "Founder & CEO" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop wax melts" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "portrait", "label": "Portrait (upload a photo you have the right to use)" },
    { "type": "text", "id": "portrait_alt", "label": "Portrait alt text", "default": "Tamara, founder of Graceful Divine Melts" },
    { "type": "image_picker", "id": "orb", "label": "Small round image (product or hands)" },
    { "type": "text", "id": "note_label", "label": "Note label", "default": "A note from Tamara" },
    { "type": "textarea", "id": "quote", "label": "Statement", "default": "Graceful Divine Melts was created from my genuine love for perfumes and candles and the way beautiful scents have always made me feel good, calm, and uplifted." },
    { "type": "text", "id": "highlight", "label": "Words to highlight", "default": "genuine love for perfumes and candles" },
    { "type": "richtext", "id": "text", "label": "Supporting text", "default": "<p>As CEO, I poured that feeling into every product, wanting others to experience the same comfort and joy I find in fragrance. What began as a personal passion has grown into a brand rooted in warmth, self-care, and feeling good in your own space.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Tamara" },
    { "type": "text", "id": "fact_1", "label": "Fact 1", "default": "Poured by hand" },
    { "type": "text", "id": "fact_2", "label": "Fact 2", "default": "Inspired by perfume" },
    { "type": "text", "id": "fact_3", "label": "Fact 3", "default": "Made in the UK" },
    { "type": "text", "id": "work_heading", "label": "Photo heading", "default": "The work" },
    { "type": "text", "id": "follow_text", "label": "Follow text", "default": "See new scents and the making of every batch." }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt", "label": "Alt text" } ] }
  ],
  "presets": [{ "name": "Founder" }]
}
{% endschema %}
