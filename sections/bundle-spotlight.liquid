{%- assign p = section.settings.product -%}
{%- if p != blank -%}
<section class="section--tight section" aria-labelledby="bs-h-{{ section.id }}">
  <div class="container">
    <div class="bundle-feature on-dark">
      <div class="bundle-feature__media">
        {%- if section.settings.image -%}{%- render 'image', image: section.settings.image, sizes: '(min-width: 860px) 50vw, 100vw', widths: '480,720,960,1280' -%}
        {%- elsif p.featured_image -%}{%- render 'image', image: p.featured_image, sizes: '(min-width: 860px) 50vw, 100vw', widths: '480,720,960,1280' -%}{%- endif -%}
      </div>
      <div class="bundle-feature__copy">
        <p class="eyebrow" style="color:var(--c-blush);margin:0">{{ section.settings.eyebrow }}</p>
        <h2 id="bs-h-{{ section.id }}">{{ section.settings.heading | default: p.title }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="bundle-feature__list" role="list">{%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.item }}</li>{%- endfor -%}</ul>
        {%- endif -%}
        <p class="bundle-feature__price">{% render 'price', product: p, show_from: true %}</p>
        <a class="btn btn--light" href="{{ p.url }}">{{ section.settings.cta | default: 'Choose your bundle' }}{% render 'icon', name: 'arrow' %}</a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Bundle spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Bundle product" },
    { "type": "image_picker", "id": "image", "label": "Image (optional, defaults to product image)" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The bundle" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Choose your bundle" }
  ],
  "blocks": [
    { "type": "item", "name": "What's included", "settings": [{ "type": "text", "id": "item", "label": "Item", "default": "2 wax melt snap bars of your choice" }] }
  ],
  "presets": [{ "name": "Bundle spotlight", "blocks": [
    { "type": "item", "settings": { "item": "2 wax melt snap bars of your choice" } },
    { "type": "item", "settings": { "item": "1 packet of mixed scent" } },
    { "type": "item", "settings": { "item": "1 wax burner" } }
  ] }]
}
{% endschema %}
