    "faq": {
      "type": "faq",
      "settings": {
        "eyebrow": "Good to know",
        "heading": "Quick answers.",
        "link_label": "All questions and the care guide",
        "link": "shopify://pages/gracefuldivinemeltswax-melt-faq"
      },
      "blocks": {
        "q0": {
          "type": "qa",
          "settings": {
            "question": "What are wax melts?",
            "answer": "<p>Wax melts are scented pieces of wax designed to release fragrance when gently warmed in a suitable wax burner. Unlike candles, they do not contain a wick.</p>"
          }
        },
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Which scent is best for me?",
            "answer": "<p>This depends on the type of fragrance you enjoy. We offer fresh, woody, spicy, floral, sweet, amber and warm scents. Read the notes on each product page, try the Mixed Scent Package, or message us for help choosing.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Are the scents the same as the perfumes?",
            "answer": "<p>Our fragrances are inspired by popular luxury perfumes. Graceful Divine Melts is not affiliated with, endorsed by or connected to any designer perfume brand, and our products are not identical copies of the originals.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Can I return or exchange my order?",
            "answer": "<p>We do not offer exchanges. For online orders, you may notify us within 14 days of receiving your order if you wish to cancel. Products must be returned unused, unopened and in their original condition and packaging. Customers are responsible for return postage unless the product is faulty, damaged or incorrect.</p><p>This does not affect your statutory rights.</p>"
          }
        }
      },
      "block_order": [
        "q0",
        "q1",
        "q2",
        "q3"
      ]
    },
